generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model alumno_contactos {
  id               BigInt                @id @default(autoincrement())
  alumno_id        BigInt
  tipo             alumno_contactos_tipo
  orden            Int?
  parentesco       String?               @db.VarChar(30)
  nombre           String                @db.VarChar(120)
  telefono         String                @db.VarChar(20)
  fecha_nacimiento DateTime?             @db.Date
  direccion        String?               @db.VarChar(255)
  created_at       DateTime              @default(now()) @db.Timestamp(0)
  alumnos          alumnos               @relation(fields: [alumno_id], references: [id], onDelete: Cascade, map: "fk_contactos_alumno")

  @@unique([alumno_id, tipo, orden], map: "uq_contacto_tutor_orden")
  @@index([alumno_id], map: "idx_contactos_alumno_id")
}

model alumnos {
  id               BigInt               @id @default(autoincrement())
  grupo_id         Int?
  pulsera_id       BigInt?              @unique(map: "uq_alumnos_pulsera_id")
  nombre           String               @db.VarChar(60)
  apellido         String               @db.VarChar(60)
  fecha_nacimiento DateTime?            @db.Date
  tipo_sangre      alumnos_tipo_sangre?
  estado           alumnos_estado       @default(normal)
  foto_url         String?
  created_at       DateTime             @default(now()) @db.Timestamp(0)
  updated_at       DateTime             @default(now()) @db.Timestamp(0)
  alumno_contactos alumno_contactos[]
  asistencias      asistencias[]
  alertas          alertas[]
  grupos           grupos?              @relation(fields: [grupo_id], references: [id], map: "fk_alumnos_grupo")
  pulseras         pulseras?            @relation(fields: [pulsera_id], references: [id], map: "fk_alumnos_pulsera")

  @@index([grupo_id], map: "idx_alumnos_grupo_id")
}

model grupos {
  id         Int       @id @default(autoincrement())
  nombre     String    @unique(map: "uq_grupos_nombre") @db.VarChar(60)
  color_id   Int       @unique(map: "uq_grupos_color_id")
  created_at DateTime  @default(now()) @db.Timestamp(0)
  alumnos    alumnos[]
  colores    colores   @relation(fields: [color_id], references: [id], map: "fk_grupos_color")
  zonas      zonas?
  docentes   docentes?

  @@index([color_id], map: "idx_grupos_color_id")
}

model colores {
  id         Int       @id @default(autoincrement())
  nombre     String?   @db.VarChar(60)
  valor_hex  String    @unique(map: "uq_colores_valor_hex") @db.Char(7)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  grupos     grupos?
  beacons    beacons[]
}

model pulseras {
  id               BigInt          @id @default(autoincrement())
  uuid             String          @unique(map: "uq_pulseras_uuid") @db.VarChar(64)
  alias            String?         @db.VarChar(60)
  estado           pulseras_estado @default(DISPONIBLE)
  mac_address      String?         @unique(map: "uq_pulseras_mac") @db.VarChar(17)
  bateria          Int?
  last_seen_at     DateTime?       @db.Timestamp(0)
  ultimo_beacon_id Int?
  ultimo_bpm       Int?
  ultimo_spo2      Decimal?        @db.Decimal(4, 1)
  ultima_temp      Decimal?        @db.Decimal(4, 1)
  created_at       DateTime        @default(now()) @db.Timestamp(0)
  updated_at       DateTime        @default(now()) @db.Timestamp(0)
  alumnos          alumnos?
}

model usuarios {
  id                       BigInt        @id @default(autoincrement())
  email                    String        @unique(map: "uq_usuarios_email") @db.VarChar(255)
  password_hash            String        @db.VarChar(255)
  rol                      usuarios_rol  @default(ADMIN)
  refresh_token_hash       String?       @db.VarChar(255)
  refresh_token_expires_at DateTime?     @db.Timestamp(0)
  foto_url                 String?
  created_at               DateTime      @default(now()) @db.Timestamp(0)
  updated_at               DateTime      @default(now()) @db.Timestamp(0)
  asistencias_confirmadas  asistencias[]
  alertas_resueltas        alertas[]
}

enum pulseras_estado {
  DISPONIBLE
  CONECTADA
  REGISTRADA
  ASIGNADA
}

enum alumno_contactos_tipo {
  TUTOR
  EMERGENCIA
}

enum alumnos_tipo_sangre {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}

enum alumnos_estado {
  normal
  alerta
  peligro
}

enum usuarios_rol {
  ADMIN
}

enum zona_tipo {
  SALON
  AREA_COMUN
  ENTRADA
  OTRO
}

model zonas {
  id         Int       @id @default(autoincrement())
  nombre     String    @db.VarChar(60)
  tipo       zona_tipo @default(SALON)
  grupo_id   Int?      @unique(map: "uq_zonas_grupo_id")
  created_at DateTime  @default(now()) @db.Timestamp(0)
  grupos     grupos?   @relation(fields: [grupo_id], references: [id], map: "fk_zonas_grupo")
  beacons    beacons[]
}

model mapas {
  id         Int       @id @default(autoincrement())
  nombre     String    @db.VarChar(60)
  imagen_url String    @db.VarChar(500)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  beacons    beacons[]
}

model beacons {
  id          Int      @id @default(autoincrement())
  beacon_id   Int      @unique(map: "uq_beacons_beacon_id")
  zona_id     Int
  mapa_id     Int?
  color_id    Int?
  mac_address String?  @unique(map: "uq_beacons_mac_address") @db.VarChar(17)
  nombre      String?  @db.VarChar(60)
  pos_x       Decimal? @db.Decimal(5, 4)
  pos_y       Decimal? @db.Decimal(5, 4)
  activo      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  zonas       zonas    @relation(fields: [zona_id], references: [id], map: "fk_beacons_zona")
  mapas       mapas?   @relation(fields: [mapa_id], references: [id], map: "fk_beacons_mapa")
  colores     colores? @relation(fields: [color_id], references: [id], map: "fk_beacons_color")

  @@index([zona_id], map: "idx_beacons_zona_id")
  @@index([mapa_id], map: "idx_beacons_mapa_id")
  @@index([color_id], map: "idx_beacons_color_id")
}

enum asistencia_estado {
  PRESENTE
  AUSENTE
  TARDANZA
}

model asistencias {
  id                BigInt            @id @default(autoincrement())
  alumno_id         BigInt
  fecha             DateTime          @db.Date
  primera_deteccion DateTime?         @db.Timestamp(0)
  ultima_deteccion  DateTime?         @db.Timestamp(0)
  estado            asistencia_estado @default(AUSENTE)
  confirmado_manual Boolean           @default(false)
  confirmado_por    BigInt?
  created_at        DateTime          @default(now()) @db.Timestamp(0)
  updated_at        DateTime          @default(now()) @db.Timestamp(0)
  alumnos           alumnos           @relation(fields: [alumno_id], references: [id], onDelete: Cascade, map: "fk_asistencias_alumno")
  usuarios          usuarios?         @relation(fields: [confirmado_por], references: [id], onDelete: SetNull, map: "fk_asistencias_confirmado_por")

  @@unique([alumno_id, fecha], map: "uq_asistencias_alumno_fecha")
  @@index([fecha], map: "idx_asistencias_fecha")
}

enum alerta_tipo {
  BPM_ALTO
  BPM_BAJO
  SPO2_BAJO
  TEMP_ANOMALA
  SIN_SENAL
}

enum alerta_severidad {
  ALERTA
  PELIGRO
}

model alertas {
  id           BigInt           @id @default(autoincrement())
  alumno_id    BigInt
  tipo         alerta_tipo
  severidad    alerta_severidad @default(ALERTA)
  valor        Decimal?         @db.Decimal(5, 2)
  beacon_id    Int?
  created_at   DateTime         @default(now()) @db.Timestamp(0)
  resuelta_at  DateTime?        @db.Timestamp(0)
  resuelta_por BigInt?
  notas        String?          @db.VarChar(255)
  alumnos      alumnos          @relation(fields: [alumno_id], references: [id], onDelete: Cascade, map: "fk_alertas_alumno")
  usuarios     usuarios?        @relation(fields: [resuelta_por], references: [id], onDelete: SetNull, map: "fk_alertas_resuelta_por")

  @@index([alumno_id, created_at], map: "idx_alertas_alumno_created_at")
  @@index([created_at], map: "idx_alertas_created_at")
}

model docentes {
  id               Int       @id @default(autoincrement())
  nombre           String    @db.VarChar(120)
  fecha_nacimiento DateTime? @db.Date
  rfc              String?   @db.VarChar(13)
  telefono         String?   @db.VarChar(20)
  correo           String?   @db.VarChar(255)
  observaciones    String?   @db.VarChar(255)
  foto_url         String?
  grupo_id         Int?      @unique(map: "uq_docentes_grupo_id")
  created_at       DateTime  @default(now()) @db.Timestamp(0)
  updated_at       DateTime  @default(now()) @db.Timestamp(0)
  grupos           grupos?   @relation(fields: [grupo_id], references: [id], map: "fk_docentes_grupo")
}
